    "# ============================================================\n",
    "# CELL 9 — MULTI-PRIOR TABLES AND FIGURES\n",
    "# ============================================================\n",
    "\n",
    "def plot_multi_prior_metric(\n",
    "    summary,\n",
    "    metric,\n",
    "    *,\n",
    "    figsize=(12, 6),\n",
    "):\n",
    "    valid = summary[\n",
    "        (summary[\"status\"] == \"ok\")\n",
    "        & summary[metric].notna()\n",
    "        & np.isfinite(summary[metric])\n",
    "    ].copy()\n",
    "\n",
    "    pivot = valid.pivot_table(\n",
    "        index=\"prior\",\n",
    "        columns=\"model\",\n",
    "        values=metric,\n",
    "        aggfunc=\"first\",\n",
    "    )\n",
    "\n",
    "    fig, ax = plt.subplots(\n",
    "        figsize=figsize\n",
    "    )\n",
    "\n",
    "    pivot.plot(\n",
    "        kind=\"bar\",\n",
    "        ax=ax,\n",
    "    )\n",
    "\n",
    "    ax.set_xlabel(\n",
    "        \"Foundation prior\",\n",
    "        fontsize=14,\n",
    "    )\n",
    "\n",
    "    ax.set_ylabel(\n",
    "        metric.replace(\"_\", \" \").upper(),\n",
    "        fontsize=14,\n",
    "    )\n",
    "\n",
    "    ax.tick_params(\n",
    "        axis=\"both\",\n",
    "        labelsize=12,\n",
    "    )\n",
    "\n",
    "    ax.legend(\n",
    "        title=\"Model\",\n",
    "        fontsize=11,\n",
    "    )\n",
    "\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    return pivot, fig, ax\n",
    "\n",
    "\n",
    "multi_prior_mape, _, _ = (\n",
    "    plot_multi_prior_metric(\n",
    "        multi_prior_summary,\n",
    "        \"mape_percent\",\n",
    "    )\n",
    ")\n",
    "\n",
    "multi_prior_rmse, _, _ = (\n",
    "    plot_multi_prior_metric(\n",
    "        multi_prior_summary,\n",
    "        \"rmse\",\n",
    "    )\n",
    ")\n",
    "\n",
    "multi_prior_msis, _, _ = (\n",
    "    plot_multi_prior_metric(\n",
    "        multi_prior_summary,\n",
    "        \"msis\",\n",
    "    )\n",
    ")\n",
    "\n",
    "multi_prior_mape.to_csv(\n",
    "    OUTPUT_DIR\n",
    "    / \"tourism_multi_prior_mape_pivot.csv\"\n",
    ")\n",
    "\n",
    "multi_prior_rmse.to_csv(\n",
    "    OUTPUT_DIR\n",
    "    / \"tourism_multi_prior_rmse_pivot.csv\"\n",
    ")\n",
