    "# ============================================================\n",
    "# CELL 7 — DATA-EFFICIENCY TABLES AND FIGURES\n",
    "# ============================================================\n",
    "\n",
    "def make_data_efficiency_pivot(\n",
    "    summary,\n",
    "    metric,\n",
    "):\n",
    "    valid = summary[\n",
    "        (summary[\"status\"] == \"ok\")\n",
    "        & summary[metric].notna()\n",
    "        & np.isfinite(summary[metric])\n",
    "    ]\n",
    "\n",
    "    return valid.pivot_table(\n",
    "        index=\"model_name\",\n",
    "        columns=\"history_size\",\n",
    "        values=metric,\n",
    "        aggfunc=\"first\",\n",
    "    )\n",
    "\n",
    "\n",
    "def plot_data_efficiency(\n",
    "    summary,\n",
    "    metric,\n",
    "    *,\n",
    "    figsize=(13, 7),\n",
    "):\n",
    "    valid = summary[\n",
    "        (summary[\"status\"] == \"ok\")\n",
    "        & summary[metric].notna()\n",
    "        & np.isfinite(summary[metric])\n",
    "    ].copy()\n",
    "\n",
    "    fig, ax = plt.subplots(\n",
    "        figsize=figsize\n",
    "    )\n",
    "\n",
    "    for model_name in (\n",
    "        valid[\"model_name\"]\n",
    "        .drop_duplicates()\n",
    "    ):\n",
    "        subset = (\n",
    "            valid[\n",
    "                valid[\"model_name\"]\n",
    "                == model_name\n",
    "            ]\n",
    "            .sort_values(\n",
    "                \"history_size\"\n",
    "            )\n",
    "        )\n",
    "\n",
    "        ax.plot(\n",
    "            subset[\"history_size\"],\n",
    "            subset[metric],\n",
    "            marker=\"o\",\n",
    "            label=model_name,\n",
    "        )\n",
    "\n",
    "    ax.set_xlabel(\n",
    "        \"Available history (N)\",\n",
    "        fontsize=14,\n",
    "    )\n",
    "\n",
    "    ax.set_ylabel(\n",
    "        metric.replace(\"_\", \" \").upper(),\n",
    "        fontsize=14,\n",
    "    )\n",
    "\n",
    "    ax.tick_params(\n",
    "        axis=\"both\",\n",
    "        labelsize=12,\n",
    "    )\n",
    "\n",
    "    ax.grid(alpha=0.3)\n",
    "\n",
    "    ax.legend(\n",
    "        bbox_to_anchor=(1.02, 1),\n",
    "        loc=\"upper left\",\n",
    "        fontsize=11,\n",
    "    )\n",
    "\n",
    "    fig.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    return fig, ax\n",
    "\n",
    "\n",
    "data_efficiency_mape = (\n",
    "    make_data_efficiency_pivot(\n",
    "        data_efficiency_summary,\n",
    "        \"mape_percent\",\n",
    "    )\n",
    ")\n",
    "\n",
    "data_efficiency_rmse = (\n",
    "    make_data_efficiency_pivot(\n",
    "        data_efficiency_summary,\n",
    "        \"rmse\",\n",
    "    )\n",
    ")\n",
    "\n",
    "data_efficiency_msis = (\n",
    "    make_data_efficiency_pivot(\n",
    "        data_efficiency_summary,\n",
    "        \"msis\",\n",
    "    )\n",
    ")\n",
    "\n",
    "print(\"MAPE pivot\")\n",
    "display(data_efficiency_mape)\n",
    "\n",
    "print(\"RMSE pivot\")\n",
    "display(data_efficiency_rmse)\n",
    "\n",
    "print(\"MSIS pivot\")\n",
    "display(data_efficiency_msis)\n",
    "\n",
    "data_efficiency_mape.to_csv(\n",
    "    OUTPUT_DIR\n",
    "    / \"tourism_data_efficiency_mape_pivot.csv\"\n",
    ")\n",
    "\n",
    "data_efficiency_rmse.to_csv(\n",
    "    OUTPUT_DIR\n",
    "    / \"tourism_data_efficiency_rmse_pivot.csv\"\n",
    ")\n",
    "\n",
    "data_efficiency_msis.to_csv(\n",
    "    OUTPUT_DIR\n",
    "    / \"tourism_data_efficiency_msis_pivot.csv\"\n",
    ")\n",
    "\n",
    "plot_data_efficiency(\n",
    "    data_efficiency_summary,\n",
    "    \"mape_percent\",\n",
    ")\n",
    "\n",
    "plot_data_efficiency(\n",
    "    data_efficiency_summary,\n",
    "    \"rmse\",\n",
    ")\n",
    "\n",
    "plot_data_efficiency(\n",
    "    data_efficiency_summary,\n",
    "    \"msis\",\n",
    ")"
   ]
