    "\n",
    "def plot_ablation_metric(\n",
    "    table,\n",
    "    metric,\n",
    "    *,\n",
    "    label_column=\"variant\",\n",
    "    figsize=(12, 5),\n",
    "):\n",
    "    valid = table[\n",
    "        (table[\"status\"] == \"ok\")\n",
    "        & table[metric].notna()\n",
    "        & np.isfinite(table[metric])\n",
    "    ].copy()\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=figsize)\n",
    "\n",
    "    ax.bar(\n",
    "        valid[label_column].astype(str),\n",
    "        valid[metric].astype(float),\n",
